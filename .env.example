# Primary extraction & reasoning model (e.g., Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_EXTRACTION_MODEL=gemini-2.5-flash

# Secondary model for inference & agreement (e.g., Groq)
GROQ_API_KEY=your_groq_api_key_here
LLM_AGREEMENT_MODEL=groq/compound-mini

# Optional: Apify API token for live Reddit data ingestion (r/googlephotos, r/GooglePixel)
APIFY_API_TOKEN=your_apify_api_token_here
